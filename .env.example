# Example environment variables for the Etsy integration
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=
ETSY_WEBHOOK_SECRET=
ETSY_KEYSTRING=
ETSY_STATUS_SECRET=
ETSY_AUTOMATION_SECRET=
ETSY_SHOP_ID=
ETSY_ADS_DAILY_LIMIT_USD=5
ETSY_MIN_ROI=2
ETSY_BASE_URL=https://openapi.etsy.com/v3/application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Etsy OAuth Tokens - automatically managed by the app
# Do not manually set these. They are stored in Vercel Blob Storage.
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=